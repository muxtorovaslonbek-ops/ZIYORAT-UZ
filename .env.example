# ── Supabase ──────────────────────────────────────────────────────────────
# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Frontend (Vite) — xuddi shu qiymatlar
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── PostgreSQL (Supabase connection string) ────────────────────────────────
# Supabase dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# ── Session & Auth ─────────────────────────────────────────────────────────
# Istalgan uzun tasodifiy matn (masalan: openssl rand -hex 32)
SESSION_SECRET=your_super_secret_key_here_min_32_chars

# ── Telegram Bot ───────────────────────────────────────────────────────────
# @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ── AI (ixtiyoriy) ────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...
OPENROUTER_API_KEY=sk-or-...
